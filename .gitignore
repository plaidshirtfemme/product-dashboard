# Local env
.env
.env.local

# Локальный Figma MCP-конфиг (инертен: desktop-app его не читает, Figma на паузе)
.mcp.json

# Конспект BA/SA (вкладка Requirements, режим Product Dashboard).
# Личные материалы Гузель: держим локально. Шаблон — единственное, что
# коммитится. Этот же файл читает scripts/deploy.py, поэтому запись через
# "/*" (а не папкой): git умеет исключение для _template.md только так,
# а деплой получает исключения по каждому файлу отдельно.
dash_app/content/ba-sa/*
!dash_app/content/ba-sa/_template.md
# Картинки к тем же конспектам. Лежат в assets/, то есть раздавались бы
# по прямой ссылке — закрываем тем же правилом, что и тексты.
assets/ba-sa/*
# Настройки Obsidian: папка дашборда открывается как второе хранилище,
# чтобы конспекты правились там же, где лежат. В продукт не входят.
.obsidian/

# Техзадания в корне — внутренние документы, в продукт не входят.
# Общее правило, а не перечисление: новое ТЗ закроется само.
*ТЗ*.md

# Knowledge Pipeline (project_mode "real") — собирается только локально,
# закрыт от публики (DASH-162). Данные уехали в dash_app/data/kp/; страницы
# режима — real_*.py (имена снимет DASH-187, переименование real→kp).
# Запись через "/*", как у ba-sa: git и scripts/deploy.py получают исключения
# по каждому файлу. scripts/deploy.py дополнительно падает, если такой файл
# всё же попал бы в архив (страж DASH-162).
dash_app/data/kp/*
dash_app/pages/real_*.py
scripts/update_vault_snapshot.py
